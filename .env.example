# Local development only. Replace the placeholder; never commit .env.
POSTGRES_DB=ledgerx
POSTGRES_USER=ledgerx_dev
POSTGRES_PASSWORD=replace-with-a-local-password
LEDGERX_DOCKER_DATABASE_URL=postgresql+psycopg://ledgerx_dev:replace-with-a-local-password@db:5432/ledgerx
# Exact browser origin for authentication cookies, CSRF origin checks and CORS.
LEDGERX_FIRST_PARTY_ORIGIN=http://localhost:3000

# Production API settings belong in the backend host's secret environment, not here.
# LEDGERX_ENVIRONMENT=production
# LEDGERX_DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@DB_HOST/ledgerx?sslmode=require
# LEDGERX_FIRST_PARTY_ORIGIN=https://YOUR_PROJECT.vercel.app
# LEDGERX_LOG_LEVEL=INFO
# Production Vercel server-only build variable:
# LEDGERX_API_ORIGIN=https://YOUR_API.onrender.com
# See docs/runbooks/production.md for TLS, migrations, recovery and role setup.
