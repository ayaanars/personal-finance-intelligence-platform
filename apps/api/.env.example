LEDGERX_ENVIRONMENT=development
# URL-encode special characters in credentials. Match root .env for local DB access.
LEDGERX_DATABASE_URL=postgresql+psycopg://ledgerx_dev:replace-with-a-local-password@127.0.0.1:5432/ledgerx
# Exact browser origin. HTTP only on loopback; HTTPS enables Secure/__Host- cookies.
LEDGERX_FIRST_PARTY_ORIGIN=http://localhost:3000
LEDGERX_LOG_LEVEL=INFO
LEDGERX_DATABASE_POOL_SIZE=5
LEDGERX_DATABASE_MAX_OVERFLOW=5
# SMTP is optional until a provider/sender has been configured. Never returns tokens.
LEDGERX_RESET_DELIVERY=disabled
# LEDGERX_SMTP_HOST=smtp.example.com
# LEDGERX_SMTP_PORT=587
# LEDGERX_SMTP_USERNAME=provider-username
# LEDGERX_SMTP_PASSWORD=replace-in-host-secret-settings
# LEDGERX_RESET_FROM_EMAIL=recovery@example.com
